    "Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Accessibility access is required to paste. Enable %@ in System Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’accessibilité est nécessaire pour coller. Activez %@ dans Réglages Système."
          }
        }
      }
    },
    "All reviewed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est relu"
          }
        }
      }
    },
    "Approve %@ in System Settings → General → Login Items to launch it at login.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez %@ dans Réglages Système → Général → Éléments de connexion pour le lancer à l’ouverture de session."
          }
        }
      }
    },

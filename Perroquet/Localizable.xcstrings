            "state": "translated",
            "value": "Système"
          }
        }
      }
    },
    "System default": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut du système"
          }
        }
      }
    },
    "System default skips Bluetooth headsets and uses your Mac's microphone instead: recording would switch them to call mode, lowering sound quality and interrupting playback.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix par défaut du système ignore les casques Bluetooth et utilise le microphone du Mac : l’enregistrement les ferait passer en mode appel, ce qui réduit la qualité sonore et interrompt la lecture."
          }
        }
      }
    },
    "Takes effect the next time %@ opens": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet au prochain lancement de %@"
          }
        }
      }
    },

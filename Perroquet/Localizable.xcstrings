        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Accessibility access is required to paste. Enable %@ in System Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’accessibilité est nécessaire pour coller. Activez %@ dans Réglages Système."

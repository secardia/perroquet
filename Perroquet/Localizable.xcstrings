      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt"
          }
        }
      }
    },
    "Recording switches a Bluetooth headset to call mode: lower sound quality, interrupted playback and a delay before your first words are heard. Prefer your Mac's microphone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement fait passer un casque Bluetooth en mode appel : qualité sonore réduite, lecture interrompue et délai avant que vos premiers mots soient entendus. Préférer le microphone du Mac."
          }
        }
      }
    },
    "Records your voice while you dictate. The audio is transcribed on this Mac and never sent anywhere.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre voix pendant la dictée. L’audio est transcrit sur ce Mac et n’est jamais envoyé ailleurs."
          }
        }
      }
    },
    "Relaunch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancer"
          }
        }
      }
    },

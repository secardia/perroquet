{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ (disconnected)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (déconnecté)"
          }
        }
      }
    },
    "Accessibility access is required to paste. Enable %@ in System Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’accessibilité est nécessaire pour coller. Activez %@ dans Réglages Système."
          }
        }
      }
    },
    "Cannot open %@: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir %@ : %@"
          }
        }
      }
    },
    "Could not load the model: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le modèle : %@"
          }
        }
      }
    },
    "Could not paste: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de coller : %@"
          }
        }
      }
    },
    "Could not save the recording: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la dictée : %@"
          }
        }
      }
    },
    "Could not start recording: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer l’enregistrement : %@"
          }
        }
      }
    },
    "Downloading… %lld%%": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement… %lld %%"
          }
        }
      }
    },
    "Failed: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec : %@"
          }
        }
      }
    },
    "Loading the model…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement du modèle…"
          }
        }
      }
    },
    "Loading…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement…"
          }
        }
      }
    },
    "Microphone access is denied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au microphone est refusé."
          }
        }
      }
    },
    "No microphone is available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun micro n’est disponible."
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt"
          }
        }
      }
    },
    "System default": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut du système"
          }
        }
      }
    },
    "The microphone format is not supported.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format du microphone n’est pas pris en charge."
          }
        }
      }
    },
    "The model is not ready yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’est pas encore prêt."
          }
        }
      }
    },
    "Transcription failed: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la transcription : %@"
          }
        }
      }
    },
    "Waiting": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente"
          }
        }
      }
    }
  }
}
